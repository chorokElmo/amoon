# Public origin only, no path/query. Set the real HTTPS domain before release.
STOREFRONT_URL=http://localhost:8000
MEDUSA_INTERNAL_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
# Optional when exactly one MAD region includes Morocco; otherwise required.
MEDUSA_REGION_ID=
MEDUSA_SALES_CHANNEL_ID=
# Server-only signing secret, generated by prepare:local.
CART_COOKIE_SECRET=
# Comma-separated exact HTTPS origins for product photos on external storage.
PRODUCT_IMAGE_ORIGINS=
LEGACY_MEDIA_ORIGINS=
# Actual owner number: international digits, without + or spaces. Blank hides links.
WHATSAPP_NUMBER=
HOMEPAGE_DEMO=false
# HTTPS endpoint returning JSON {"accepted":true} after storing/queuing consent.
NEWSLETTER_SUBSCRIBE_URL=
NEWSLETTER_API_TOKEN=
