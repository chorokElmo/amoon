# Copy to .env. Generate independent secrets: openssl rand -hex 32
# PostgreSQL password must be URL-safe (hex recommended).
POSTGRES_USER=amoon
POSTGRES_DB=amoon
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
STOREFRONT_URL=http://localhost:8000
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
# Create in Medusa Admin and associate with the storefront sales channel.
MEDUSA_PUBLISHABLE_KEY=
# International digits only, e.g. 212 followed by the store's number.
WHATSAPP_NUMBER=
